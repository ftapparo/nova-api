    "/v3/api/tag/cache": {
      "get": {
        "tags": ["Tag"],
        "summary": "Cache de TAGs validadas",
        "description": "Retorna as entradas do cache de validação de TAGs do dispositivo informado, com estatísticas.",
        "operationId": "getTagCache",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "numeroDispositivo",
            "in": "query",
            "required": true,
            "description": "Número do dispositivo cadastrado no controle de acesso.",
            "schema": { "type": "integer" }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filtra por tipo de cache. Omitido retorna todos.",
