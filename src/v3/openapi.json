{
  "openapi": "3.0.3",
  "info": {
    "title": "Nova API — v3",
    "version": "3.0.0",
    "description": "API v3 - Condomínio Nova Residence"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Disponibilidade do serviço, sem dependência de nenhum recurso externo."
    },
    {
      "name": "Auth",
      "description": "Login, renovação e encerramento de sessão (Supabase Auth). Demais rotas de negócio exigem Authorization: Bearer <accessToken>."
    },
    {
      "name": "Tag",
      "description": "Controle de acesso veicular via RFID (portões)."
    },
    {
      "name": "CIE",
      "description": "Central de incêndio."
    }
  ],
  "components": {
    "schemas": {
      "ResponseMeta": {
        "type": "object",
        "description": "Metadado transversal presente em toda resposta, dentro ou fora do envelope de sucesso/erro.",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Instante em que a resposta foi gerada.",
            "example": "2026-09-28T03:44:40.342Z"
          },
          "requestId": {
            "type": "string",
            "nullable": true,
            "description": "Identificador da requisição, para correlação em logs e suporte.",
            "example": "req-1"
          },
          "version": {
            "type": "string",
            "enum": ["v3"],
            "description": "Versão da API que gerou a resposta."
          },
          "pagination": {
            "type": "object",
            "description": "Presente somente em endpoints que retornam uma coleção paginada.",
            "properties": {
              "limit": { "type": "integer", "minimum": 1, "example": 25 },
              "offset": { "type": "integer", "minimum": 0, "example": 0 },
              "total": { "type": "integer", "minimum": 0, "example": 137 }
            },
            "required": ["limit", "offset", "total"]
          }
        },
        "required": ["timestamp", "requestId", "version"]
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Estrutura padrão de erro da API, com tipo, título, status HTTP e detalhe da ocorrência.",
        "properties": {
          "type": {
            "type": "string",
            "description": "URN fixo identificando o tipo do erro (não é uma URL navegável).",
            "example": "urn:nova-api:validation-error"
          },
          "title": {
            "type": "string",
            "description": "Resumo legível do tipo de erro.",
            "example": "Dados de entrada inválidos"
          },
          "status": {
            "type": "integer",
            "description": "Código HTTP correspondente, redundante com o status da resposta.",
            "example": 400
          },
          "detail": {
            "type": "string",
            "nullable": true,
            "description": "Explicação específica desta ocorrência do erro.",
            "example": "Um ou mais campos da requisição são inválidos."
          },
          "instance": {
            "type": "string",
            "nullable": true,
            "description": "Path da requisição que originou o erro.",
            "example": "/v3/api/health"
          },
          "validationErrors": {
            "type": "array",
            "description": "Presente somente quando type = validation-error.",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "example": "/name" },
                "message": { "type": "string", "example": "Too small: expected string to have >=3 characters" }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": { "$ref": "#/components/schemas/ProblemDetails" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "error", "meta"]
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["API Funcionando!"],
            "example": "API Funcionando!"
          },
          "environment": {
            "type": "string",
            "description": "Valor de NODE_ENV do processo.",
            "example": "production"
          }
        },
        "required": ["status", "environment"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/HealthData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "GateStateData": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["closed", "opening", "open", "closing", "unknown"],
            "example": "closed"
          }
        },
        "required": ["state"]
      },
      "GateStateResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/GateStateData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "AccessVerifyData": {
        "type": "object",
        "description": "Dados de identificação retornados pela verificação de acesso.",
        "properties": {
          "PERMITIDO": { "type": "string" },
          "SEQPESSOA": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
          "SEQCLASSIFICACAO": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
          "CLASSIFAUTORIZADA": { "type": "string" },
          "AUTORIZACAOLANC": { "type": "string" },
          "TIPO": { "type": "string" },
          "SEQIDACESSO": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
          "QUADRA": { "type": "string" },
          "LOTE": { "type": "string" },
          "PANICO": { "type": "string" },
          "MIDIA": { "type": "string" },
          "IDENT": { "type": "string" },
          "SEQVEICULO": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
          "NOME": { "type": "string" },
          "DESCRICAO": { "type": "string" }
        }
      },
      "TagCacheItem": {
        "type": "object",
        "properties": {
          "tag": { "type": "string" },
          "validatedAt": { "type": "string", "format": "date-time" },
          "isValid": { "type": "boolean" },
          "accessId": { "type": "string" },
          "verifyData": { "$ref": "#/components/schemas/AccessVerifyData" }
        },
        "required": ["tag", "validatedAt", "isValid"]
      },
      "CacheStats": {
        "type": "object",
        "properties": {
          "positiveSize": { "type": "integer" },
          "negativeSize": { "type": "integer" },
          "positiveTimeout": { "type": "integer" },
          "negativeTimeout": { "type": "integer" }
        },
        "required": ["positiveSize", "negativeSize", "positiveTimeout", "negativeTimeout"]
      },
      "ListCacheData": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["positive", "negative", "all"] },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/TagCacheItem" } },
          "stats": { "$ref": "#/components/schemas/CacheStats" }
        },
        "required": ["type", "items", "stats"]
      },
      "ListCacheResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/ListCacheData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "NomeModelo": {
        "type": "object",
        "properties": {
          "endereco": { "type": "integer" },
          "nome": { "type": "string" },
          "modelo": { "type": "string" }
        },
        "required": ["endereco", "nome", "modelo"]
      },
      "DataHora": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "integer" },
          "utc": { "type": "string", "format": "date-time" },
          "local": { "type": "string" }
        },
        "required": ["timestamp", "utc", "local"]
      },
      "StatusCounters": {
        "type": "object",
        "properties": {
          "alarme": { "type": "integer" },
          "falha": { "type": "integer" },
          "supervisao": { "type": "integer" },
          "bloqueio": { "type": "integer" },
          "regrasTemporizando": { "type": "integer" }
        },
        "required": ["alarme", "falha", "supervisao", "bloqueio", "regrasTemporizando"]
      },
      "CieStateSnapshot": {
        "type": "object",
        "properties": {
          "connected": { "type": "boolean" },
          "restartingUntil": { "type": "integer", "nullable": true },
          "nomeModelo": { "allOf": [{ "$ref": "#/components/schemas/NomeModelo" }], "nullable": true },
          "mac": { "type": "object", "nullable": true, "properties": { "mac": { "type": "string" } } },
          "info": { "type": "object", "nullable": true, "additionalProperties": { "type": "integer" } },
          "dataHora": { "allOf": [{ "$ref": "#/components/schemas/DataHora" }], "nullable": true },
          "status": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": { "$ref": "#/components/schemas/StatusCounters" },
              "leds": { "type": "object", "additionalProperties": { "type": "boolean" } }
            }
          },
          "lastUpdated": { "type": "integer", "nullable": true },
          "lastError": { "type": "string", "nullable": true },
          "reconnecting": { "type": "boolean" },
          "reconnectAttempt": { "type": "integer" }
        },
        "required": ["connected", "restartingUntil", "nomeModelo", "mac", "info", "dataHora", "status", "lastUpdated", "lastError", "reconnecting", "reconnectAttempt"]
      },
      "CieStatusResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/CieStateSnapshot" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "PanelData": {
        "type": "object",
        "properties": {
          "online": { "type": "boolean" },
          "connected": { "type": "boolean" },
          "restarting": { "type": "boolean" },
          "restartingUntil": { "type": "integer", "nullable": true },
          "reconnecting": { "type": "boolean" },
          "reconnectAttempt": { "type": "integer" },
          "lastError": { "type": "string", "nullable": true },
          "lastUpdated": { "type": "integer", "nullable": true },
          "central": {
            "type": "object",
            "properties": {
              "ip": { "type": "string", "nullable": true },
              "endereco": { "type": "integer" },
              "nome": { "type": "string", "nullable": true },
              "modelo": { "type": "string", "nullable": true },
              "mac": { "type": "string", "nullable": true }
            },
            "required": ["ip", "endereco", "nome", "modelo", "mac"]
          },
          "dataHora": { "allOf": [{ "$ref": "#/components/schemas/DataHora" }], "nullable": true },
          "counters": { "allOf": [{ "$ref": "#/components/schemas/StatusCounters" }], "nullable": true },
          "leds": { "type": "object", "nullable": true, "additionalProperties": { "type": "boolean" } },
          "latestFailureEvent": { "allOf": [{ "$ref": "#/components/schemas/NormalizedCieLog" }], "nullable": true },
          "latestAlarmEvent": { "allOf": [{ "$ref": "#/components/schemas/NormalizedCieLog" }], "nullable": true }
        },
        "required": ["online", "connected", "restarting", "restartingUntil", "reconnecting", "reconnectAttempt", "lastError", "lastUpdated", "central", "dataHora", "counters", "leds", "latestFailureEvent", "latestAlarmEvent"]
      },
      "PanelResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/PanelData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "DeviceClassification": {
        "type": "object",
        "properties": {
          "typeCode": { "type": "integer", "nullable": true },
          "subtypeCode": { "type": "integer", "nullable": true },
          "typeLabel": { "type": "string", "nullable": true },
          "subtypeLabel": { "type": "string", "nullable": true },
          "resolvedLabel": { "type": "string", "nullable": true },
          "source": { "type": "string", "enum": ["codes", "name", "none"] }
        },
        "required": ["typeCode", "subtypeCode", "typeLabel", "subtypeLabel", "resolvedLabel", "source"]
      },
      "NormalizedCieLog": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["alarme", "falha", "supervisao", "operacao", "bloqueio"] },
          "id": { "type": "integer" },
          "zone": { "type": "integer", "nullable": true },
          "address": { "type": "integer", "nullable": true },
          "loop": { "type": "integer", "nullable": true },
          "deviceName": { "type": "string", "nullable": true },
          "zoneName": { "type": "string", "nullable": true },
          "deviceTypeCode": { "type": "integer", "nullable": true },
          "deviceTypeLabel": { "type": "string", "nullable": true },
          "deviceClassification": { "allOf": [{ "$ref": "#/components/schemas/DeviceClassification" }], "nullable": true },
          "eventType": { "type": "integer", "nullable": true },
          "blocked": { "type": "boolean", "nullable": true },
          "occurredAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "integer" }
        },
        "required": ["key", "type", "id", "zone", "address", "loop", "deviceName", "zoneName", "deviceTypeCode", "deviceTypeLabel", "deviceClassification", "eventType", "blocked", "occurredAt", "createdAt"]
      },
      "AlarmActiveSnapshot": {
        "type": "object",
        "properties": {
          "isTriggered": { "type": "boolean" },
          "counters": {
            "type": "object",
            "properties": {
              "alarme": { "type": "integer" },
              "falha": { "type": "integer" },
              "supervisao": { "type": "integer" },
              "bloqueio": { "type": "integer" }
            },
            "required": ["alarme", "falha", "supervisao", "bloqueio"]
          },
          "latestAlarmLogs": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } }
        },
        "required": ["isTriggered", "counters", "latestAlarmLogs"]
      },
      "AlarmActiveResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/AlarmActiveSnapshot" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "LogsListData": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "alarme" },
          "limit": { "type": "integer", "example": 50 },
          "cursor": { "type": "string", "nullable": true },
          "nextCursor": { "type": "string", "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } }
        },
        "required": ["type", "limit", "cursor", "nextCursor", "items"]
      },
      "LogsListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/LogsListData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "BlockCounters": {
        "type": "object",
        "properties": {
          "dispositivo": { "type": "integer" },
          "sirene": { "type": "integer" },
          "saida": { "type": "integer" },
          "atuador": { "type": "integer" },
          "regra": { "type": "integer" },
          "zona": { "type": "integer" },
          "laco": { "type": "integer" },
          "dispositivoLaco0": { "type": "integer" },
          "dispositivoLaco1": { "type": "integer" },
          "dispositivoLaco2": { "type": "integer" },
          "saidaLaco0": { "type": "integer" },
          "saidaLaco1": { "type": "integer" },
          "saidaLaco2": { "type": "integer" },
          "sireneLaco0": { "type": "integer" },
          "sireneLaco1": { "type": "integer" },
          "sireneLaco2": { "type": "integer" },
          "atuadorLaco0": { "type": "integer" },
          "atuadorLaco1": { "type": "integer" },
          "atuadorLaco2": { "type": "integer" }
        }
      },
      "BlockCountersResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/BlockCounters" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "OutputCounters": {
        "type": "object",
        "properties": {
          "saidaLaco0": { "type": "integer" },
          "saidaLaco1": { "type": "integer" },
          "saidaLaco2": { "type": "integer" },
          "sireneLaco0": { "type": "integer" },
          "sireneLaco1": { "type": "integer" },
          "sireneLaco2": { "type": "integer" },
          "atuadorLaco0": { "type": "integer" },
          "atuadorLaco1": { "type": "integer" },
          "atuadorLaco2": { "type": "integer" },
          "saida": { "type": "integer" },
          "sirene": { "type": "integer" },
          "atuador": { "type": "integer" }
        }
      },
      "OutputCountersResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/OutputCounters" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "nullable": true },
          "role": {
            "type": "string",
            "nullable": true,
            "enum": ["morador", "portaria", "sindico", "admin", "servico"],
            "description": "Papel da aplicação. null quando a conta ainda não tem papel atribuído."
          }
        },
        "required": ["id", "email", "role"]
      },
      "SessionData": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "description": "JWT de acesso. Enviar em Authorization: Bearer <accessToken>." },
          "refreshToken": { "type": "string", "description": "Uso único: cada refresh devolve um novo refresh token." },
          "tokenType": { "type": "string", "enum": ["bearer"] },
          "expiresIn": { "type": "integer", "description": "Segundos até o access token expirar.", "example": 900 },
          "expiresAt": { "type": "integer", "description": "Expiração do access token (Unix epoch, segundos)." },
          "user": { "$ref": "#/components/schemas/AuthUser" }
        },
        "required": ["accessToken", "refreshToken", "tokenType", "expiresIn", "expiresAt", "user"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/SessionData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/AuthUser" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "nullable": true, "description": "Sempre null." },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Não autorizado — token ausente, inválido ou expirado.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Rota inexistente.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "error": {
                "type": "urn:nova-api:not-found",
                "title": "Recurso não encontrado",
                "status": 404,
                "detail": "Rota GET /v3/api/rota-que-nao-existe não existe.",
                "instance": "/v3/api/rota-que-nao-existe"
              },
              "meta": {
                "timestamp": "2026-09-28T03:24:14.989Z",
                "requestId": "req-2",
                "version": "v3"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token obtido em POST /v3/api/auth/login. Expira em 15 minutos; renovar em POST /v3/api/auth/refresh."
      }
    }
  },
  "paths": {
    "/v3/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck do serviço",
        "description": "Verifica disponibilidade da camada HTTP da v3. Não valida dependências externas (Firebird, Postgres).",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Serviço operando normalmente.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "success": true,
                  "data": { "status": "API Funcionando!", "environment": "production" },
                  "meta": {
                    "timestamp": "2026-09-28T03:44:40.342Z",
                    "requestId": "req-1",
                    "version": "v3"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v3/api/healthcheck": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck do serviço (alias)",
        "description": "Alias de /v3/api/health. Mesmo handler e resposta, mantido por compatibilidade de convenção com a v2.",
        "operationId": "getHealthcheck",
        "responses": {
          "200": {
            "description": "Serviço operando normalmente.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "success": true,
                  "data": { "status": "API Funcionando!", "environment": "production" },
                  "meta": {
                    "timestamp": "2026-09-28T03:44:40.342Z",
                    "requestId": "req-1",
                    "version": "v3"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v3/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Autentica com e-mail e senha. Contas são criadas apenas por processo administrativo (cadastro público desativado).",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" } },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } }
          },
          "400": {
            "description": "Dados de entrada inválidos.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "Muitas tentativas.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "Serviço de autenticação indisponível.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/v3/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cadastro público",
        "description": "Cria a conta do morador (papel sempre `morador`, definido pela API) e já devolve a sessão. Versão básica: ainda não confere o cadastro no Firebird.",
        "operationId": "authSignup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada e sessão iniciada.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } }
          },
          "400": {
            "description": "Dados de entrada inválidos ou recusados pela política de senha.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Já existe uma conta com este e-mail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "Serviço de autenticação indisponível.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/v3/api/auth/users": {
      "post": {
        "tags": ["Auth"],
        "summary": "Criar conta (admin)",
        "description": "Cria uma conta com qualquer papel. Exige usuário `admin`. O primeiro admin é promovido direto no banco.",
        "operationId": "authCreateUser",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "role": { "type": "string", "enum": ["morador", "portaria", "sindico", "admin", "servico"] }
                },
                "required": ["email", "password", "role"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthUserResponse" } } }
          },
          "400": {
            "description": "Dados de entrada inválidos ou recusados pela política de senha.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Usuário sem papel admin.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Já existe uma conta com este e-mail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "Serviço de autenticação indisponível.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/v3/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Renovar sessão",
        "description": "Troca um refresh token por um novo par de tokens.",
        "operationId": "authRefresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "refreshToken": { "type": "string" } },
                "required": ["refreshToken"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } }
          },
          "400": {
            "description": "Dados de entrada inválidos.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Refresh token inválido ou revogado.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "Muitas tentativas.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "Serviço de autenticação indisponível.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/v3/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
