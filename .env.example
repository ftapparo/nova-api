# =============================================================================
# nova-api — variáveis de ambiente
#
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# =============================================================================

# Ambiente de execução
NODE_ENV=production
PORT=3030

# -----------------------------------------------------------------------------
# Segurança (adicionadas na contenção de segurança — ver PLANO-MELHORIAS-MOBILE.md)
# -----------------------------------------------------------------------------

# Origens de navegador autorizadas a chamar a API, separadas por vírgula.
# Sem esta variável, nenhuma requisição com cabeçalho Origin é aceita.
# Requisições sem Origin (server-to-server) seguem permitidas.
#
# Durante a migração de domínio (condominionovaresidence → novaresidence),
# ambos ficam na lista. Remover o antigo quando a migração concluir.
#
# A portaria também acessa pelo IP interno na rede local (sem HTTPS,
# sem passar pelo Cloudflare) — precisa constar aqui também, senão o
# navegador recebe erro de CORS mesmo com a API respondendo normalmente.
CORS_ALLOWED_ORIGINS=https://adm.condominionovaresidence.com,https://adm.novaresidence.com.br,http://192.168.0.250:8080

# Documentação Swagger. Mantenha 'false' em produção: o spec cataloga
# todos os endpoints, inclusive os que acionam portões e a central de incêndio.
SWAGGER_ENABLED=false

# Tamanho máximo do corpo das requisições.
BODY_LIMIT=256kb

# Rate limit por IP, por janela de 60 segundos.
# RATE_LIMIT_COMMAND_MAX vale para rotas de ação física e envio de push.
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_COMMAND_MAX=15

# -----------------------------------------------------------------------------
# Banco de dados Firebird
# -----------------------------------------------------------------------------
FIREBIRD_HOST=192.168.0.x
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\caminho\para\BASE.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=
FIREBIRD_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Servidor Freedom PROANSI
# -----------------------------------------------------------------------------
FREEDOM_HOST=192.168.0.x
FREEDOM_PORT=8080

# -----------------------------------------------------------------------------
# Serviço TAG (portões) e controle de acesso
# -----------------------------------------------------------------------------
TAG_CONTROL_HOST=192.168.0.250
TAG_CONTROL_BASE_PORT=4000
CONTROL_BASE_URL=
CONTROL_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Exaustores das churrasqueiras
# -----------------------------------------------------------------------------
EXHAUST_A_14_HOST=192.168.0.x
EXHAUST_A_58_HOST=192.168.0.x
EXHAUST_B_14_HOST=192.168.0.x
EXHAUST_B_58_HOST=192.168.0.x
EXHAUST_C_14_HOST=192.168.0.x
EXHAUST_C_58_HOST=192.168.0.x
EXHAUST_PWR_14_HOST=192.168.0.x
EXHAUST_PWR_58_HOST=192.168.0.x
EXHAUST_MEMORY_DIR=/app/storage/exhaust
EXHAUST_SWEEP_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Consulta de placa
# -----------------------------------------------------------------------------
VEHICLE_LOOKUP_TIMEOUT_MS=15000
VEHICLE_LOOKUP_PROVIDER_1_URL=
VEHICLE_LOOKUP_PROVIDER_2_URL=
VEHICLE_LOOKUP_PROVIDER_3_URL=
VEHICLE_LOOKUP_SCRAPING_ENABLED=false
VEHICLE_LOOKUP_SCRAPING_API1_ENABLED=false
VEHICLE_LOOKUP_SCRAPING_API2_ENABLED=false
VEHICLE_LOOKUP_WDAPI_ENABLED=false
VEHICLE_LOOKUP_WDAPI_URL_TEMPLATE=
VEHICLE_LOOKUP_WDAPI_TOKEN=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true

# -----------------------------------------------------------------------------
# Persistência
# -----------------------------------------------------------------------------
USER_SETTINGS_DIR=/app/storage/user-settings
PUSH_SUBSCRIPTIONS_DIR=/app/storage/push-subscriptions

# -----------------------------------------------------------------------------
# Logs e auditoria
# -----------------------------------------------------------------------------
LOG_TO_FILE=true
LOG_DIR=/app/logs
COMMAND_LOG_DIR=/app/logs/api-commands
COMMAND_LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# Gerar com: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:contato@novaresidence.com.br
