# =============================================================================
# Stack nova-postgres — variáveis de ambiente
#
# Copie os valores abaixo para o campo "Environment variables" da stack no
# Portainer. Não existe .env real neste diretório versionado no Git — a
# senha real fica só no .env local da sua máquina e na stack do Portainer.
# =============================================================================

POSTGRES_DB=nova_residence
POSTGRES_USER=nova_app
POSTGRES_PASSWORD=<gerar senha forte — nunca reaproveitar de outro serviço>
