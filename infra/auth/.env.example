# =============================================================================
# Stack nova-auth (Supabase Auth / GoTrue) — variáveis de ambiente
#
# Copie os valores reais para o campo "Environment variables" da stack no
# Portainer. Os valores de SUPABASE_AUTH_ADMIN_PASSWORD e JWT_SECRET já
# foram gerados e estão em API/infra/postgres/.env (local, fora do Git).
# =============================================================================

# URL pública pela qual a API do Auth se identifica (usada em GOTRUE_JWT_ISSUER
# e nos links de e-mail, quando SMTP for configurado). Usar o domínio da API,
# não o do painel — o Auth é conversado pela nova-api, não diretamente pelo
# navegador.
API_EXTERNAL_URL=https://api.novaresidence.com.br

# Para onde o GoTrue permite redirecionar após login/confirmação (deixar
# vazio por enquanto — sem fluxo de redirect configurado ainda).
ADDITIONAL_REDIRECT_URLS=

# Expiração do access token, em segundos. 900 = 15 minutos.
JWT_EXPIRY=900

# Segredo compartilhado entre o Auth e a nova-api (para validar JWT
# localmente, sem chamar o Auth a cada requisição). Gerar com:
#   openssl rand -base64 32
# (ou, no Node: require('crypto').randomBytes(32).toString('base64'))
JWT_SECRET=<ver API/infra/postgres/.env>

# Credenciais do role Postgres dedicado ao Auth (schema "auth" apenas).
# Criado por API/infra/postgres/setup-roles.sql.
SUPABASE_AUTH_ADMIN_USER=supabase_auth_admin
SUPABASE_AUTH_ADMIN_PASSWORD=<ver API/infra/postgres/.env>

# Nome do banco (mesmo da stack nova-postgres).
POSTGRES_DB=nova_residence
